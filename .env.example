# PostgreSQL for production. Use a pooled connection URL on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nation?schema=public"
# Required once authentication is enabled. Generate a high-entropy value.
AUTH_SECRET="replace-with-a-long-random-secret"
# Número de WhatsApp que recibirá los contactos de la landing, con código de país y sin +.
# Ejemplo para Colombia: 573001234567
WHATSAPP_NUMBER=
